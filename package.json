{
  "name": "folio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "node scripts/check-routes.mjs && astro build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply folio-db --local",
    "db:remote": "wrangler d1 migrations apply folio-db --remote",
    "check": "astro check",
    "check:routes": "node scripts/check-routes.mjs",
    "test:e2e": "astro build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:report": "playwright show-report",
    "shots": "node tests/tools/shots.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.6",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.0",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
