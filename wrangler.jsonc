{
	// The Astro adapter fills in `main` and `assets` at build time.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "folio",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
      {
        "binding": "folio_db",
        "database_id": "d261f15a-72ba-41fd-9bad-bc8fd2ba0e05"
      }
    ],
    "r2_buckets": [
      {
        "binding": "folio-assets",
        "bucket_name": "folio-assets"
      }
    ],
    "images": {
      "binding": "IMAGES"
    }
}
