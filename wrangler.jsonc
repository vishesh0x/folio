{
	// Cloudflare Worker configuration.
	//
	// The Astro adapter fills in `main` and `assets` at build time (dist/server/wrangler.json). The
	// environment that is built is chosen by CLOUDFLARE_ENV at build time, not by `wrangler deploy --env`:
	// after a normal build, `--env <name>` is silently ignored and the production configuration is
	// deployed. There is deliberately no staging environment. If one is added, its bindings must be
	// repeated in full (bindings are not inherited) and must not share the production database or bucket;
	// tests/e2e/data/wrangler-config.spec.ts checks both.
	//
	// Secrets are never written in this file. Set them with `npx wrangler secret put <NAME>`, and in
	// .dev.vars for local work (see .dev.vars.example):
	//   ADMIN_SETUP_TOKEN      One-time token for creating the first admin account. Also the fallback
	//                          source of the rate-limit key.
	//   RATE_LIMIT_SALT        Recommended. Rate-limit counters are stored under a keyed hash of the
	//                          visitor's network.
	//   TURNSTILE_SECRET_KEY   Only when Turnstile is used. Pairs with TURNSTILE_SITE_KEY below.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "folio",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],

	// The site is reached only on its own domain (Worker > Settings > Domains & Routes). The extra
	// addresses that Cloudflare would otherwise create (folio.<account>.workers.dev, and one per uploaded
	// version) would bypass the zone's firewall (WAF) and rate-limit rules and would serve a second copy
	// of every page. Setting both to false also stops `wrangler deploy` from switching them back on.
	"workers_dev": false,
	"preview_urls": false,

	"vars": {
		// Public key of the Cloudflare Turnstile widget used on the contact form and the sign-in page.
		// Safe to commit, because it is printed in every page that shows the widget. Replace it with the
		// key of your own widget, or remove it to run without Turnstile.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFNLlH_NrctHUs4o"
	},
	// Keeps logs, so that errors behind the "Something broke" page can be found.
	"observability": { "enabled": true },

	// Binding names must match what the code reads (src/env.d.ts): env.DB, env.ASSETS_BUCKET, env.IMAGES.
	// Replace database_id with the id printed by `npx wrangler d1 create folio-db`.
	"d1_databases": [{ "binding": "DB", "database_name": "folio-db", "database_id": "d261f15a-72ba-41fd-9bad-bc8fd2ba0e05", "migrations_dir": "migrations" }],
	"r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "folio-assets" }],
	"images": { "binding": "IMAGES" }
}
