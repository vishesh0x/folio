---
// Title row at the top of every dashboard page. The default slot holds the page's main actions (buttons), aligned right.
interface Props { title: string; lede?: string; }
const { title, lede } = Astro.props;
const hasActions = Astro.slots.has('default');
---
<header class="page-head">
  <div>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
  {hasActions && <div class="page-actions"><slot /></div>}
</header>
