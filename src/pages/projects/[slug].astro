---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { getPublished, neighbours } from '../../lib/projects';
import { renderMarkdown, excerpt } from '../../lib/markdown';
import { loadAsset } from '../../lib/media';
import { getPublicSettings } from '../../lib/settings';
import codeFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const p = await getPublished(Astro.params.slug ?? '');
if (!p) return Astro.rewrite('/404');

const [{ html, toc }, { prev, next }, s] = await Promise.all([renderMarkdown(p.body_md), neighbours(p), getPublicSettings()]);
const seoImg = await loadAsset(p.seo_image ?? undefined);
const ogImage = seoImg && seoImg.mime !== 'image/svg+xml' ? `/media/${seoImg.id}/${encodeURIComponent(seoImg.filename)}?w=1280&f=jpeg`
  : p.cover && p.cover.mime !== 'image/svg+xml' ? `/media/${p.cover.id}/${encodeURIComponent(p.cover.filename)}?w=1280&f=jpeg` : undefined;
const hasCode = /<code[\s>]/.test(html); // the code font is only needed (and only fetched early) on pages that show code
const description = p.seo_desc || p.summary || excerpt(p.body_md);
const year = new Date(p.created_at * 1000).getFullYear();
const siteUrl = (s.site_url || Astro.url.origin).replace(/\/$/, '');
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` }, { '@type': 'ListItem', position: 2, name: 'Projects', item: `${siteUrl}/projects` },
  { '@type': 'ListItem', position: 3, name: p.title, item: `${siteUrl}/projects/${p.slug}` }] };
const ld = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: p.title, description, author: { '@type': 'Person', name: s.name },
  dateCreated: new Date(p.created_at * 1000).toISOString(), dateModified: new Date(p.updated_at * 1000).toISOString(), keywords: p.tags.join(', ') || undefined,
  codeRepository: p.source_url || undefined };
---
<Base title={p.seo_title || p.title} description={description} ogImage={ogImage} ogAlt={p.cover?.alt || p.title} ogType="article" published={new Date(p.created_at * 1000)} modified={new Date(p.updated_at * 1000)}>
  {hasCode && <link slot="head" rel="preload" href={codeFont} as="font" type="font/woff2" crossorigin />}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbs).replace(/</g, '\\u003c')} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />

  <article class="wrap project">
    <p class="crumb"><a href="/projects">← All projects</a></p>
    <header class="project-head">
      <div class="project-meta"><span class="eyebrow" style="margin:0">{year}</span>{p.tags.length > 0 && <ul class="tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>}</div>
      <h1>{p.title}</h1>
      {p.summary && <p class="lead">{p.summary}</p>}
      {(p.live_url || p.source_url) && (
        <p class="hero-cta">
          {p.live_url && <a class="btn" href={p.live_url} target="_blank" rel="noopener noreferrer">Live site <span aria-hidden="true">↗</span></a>}
          {p.source_url && <a class="btn ghost" href={p.source_url} target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a>}
        </p>
      )}
    </header>

    {p.cover && <figure class="project-cover" style="margin-inline:0"><div class="frame"><Img asset={p.cover} eager natural sizes="(min-width: 72rem) 72rem, 100vw" /></div></figure>}

    <div class={toc.length >= 3 ? 'project-body has-toc' : 'project-body'}>
      <div class="md" set:html={html} />
      {toc.length >= 3 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <ol>{toc.map((t) => <li class={`d${t.depth}`}><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </nav>
      )}
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="More projects">
        {prev ? <a href={`/projects/${prev.slug}`} data-astro-prefetch="hover"><span>Previous</span>{prev.title}</a> : <span />}
        {next ? <a href={`/projects/${next.slug}`} style="text-align:right"><span>Next</span>{next.title}</a> : <span />}
      </nav>
    )}
  </article>
</Base>

<script>
  // Diagrams (```mermaid): Mermaid is downloaded only if this page has one, and only when it is about to scroll into view.
  if (document.querySelector('figure[data-diagram]')) import('../../scripts/diagrams').then((m) => m.renderDiagrams());
</script>
