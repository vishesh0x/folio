---
import Base from '../layouts/Base.astro';
import ErrorView from '../components/ErrorView.astro';
import { listPublished } from '../lib/projects';
Astro.response.status = 404;
let recent: { slug: string; title: string }[] = [];
try { recent = (await listPublished({ limit: 3 })).map((p) => ({ slug: p.slug, title: p.title })); } catch {}
---
<Base title="Page not found" noindex errorPage>
  <ErrorView code="404" kicker="Off the map" title="This page wandered off." art="compass">
    <p class="lead">The address may have a typo, or the page may have moved or been removed.</p>
    <p class="hero-cta"><a class="btn" href="/">Back to the start</a><a class="btn ghost" href="/projects">Browse projects</a></p>
    {recent.length > 0 && (
      <div class="err-more"><p class="eyebrow">Or have a look at</p>
        <ul>{recent.map((p) => <li><a href={`/projects/${p.slug}`}>{p.title}</a></li>)}</ul></div>
    )}
  </ErrorView>
</Base>
