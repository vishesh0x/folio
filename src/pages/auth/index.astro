---
import Base from '../../layouts/Base.astro';
import { getSettings } from '../../lib/settings';
import {
  MIN_PASSWORD, validateEmail, validatePassword, isLimited, recordFailure, clearFailures,
  createSession, getUser, login, hasAnyUser, setupEnabled, checkSetupToken, createFirstAdmin, clientKey, accountKey, ACCOUNT_MAX_FAILS, ACCOUNT_WINDOW_SECS,
} from '../../lib/auth';
import { turnstileOn, turnstileSiteKey, verifyTurnstile } from '../../lib/turnstile';
import { ipOf } from '../../lib/throttle';

if (await getUser(Astro.cookies)) return Astro.redirect('/dashboard');

const adminExists = await hasAnyUser();
const canSetup = !adminExists && setupEnabled();
let error = '';
let email = '';
let challenge = false; // show a Turnstile check: set when too many wrong passwords have been tried for this account

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const mode = String(form.get('mode') ?? '');
  email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');

  if (mode === 'setup') {
    const key = await clientKey('setup', Astro.request);
    if (adminExists || !setupEnabled()) {
      Astro.response.status = 403;
      error = 'Registration is closed.';
    } else if (await isLimited(key)) {
      Astro.response.status = 429;
      error = 'Too many attempts. Try again in 15 minutes.';
    } else if (!checkSetupToken(String(form.get('token') ?? ''))) {
      await recordFailure(key);
      Astro.response.status = 403;
      error = 'That setup token is not correct.';
    } else if ((error = validateEmail(email) ?? validatePassword(password, email) ?? '')) {
      Astro.response.status = 400;
    } else if (password !== String(form.get('confirm') ?? '')) {
      Astro.response.status = 400;
      error = 'The two passwords do not match.';
    } else {
      const id = await createFirstAdmin(email, password);
      if (id === null) { Astro.response.status = 409; error = 'An admin already exists.'; }
      else { await clearFailures(key); await createSession(id, Astro.cookies); return Astro.redirect('/dashboard'); }
    }
  } else if (mode === 'login') {
    const key = await clientKey('login', Astro.request);
    const acct = await accountKey(email);
    if (await isLimited(key)) {
      Astro.response.status = 429;
      error = 'Too many attempts. Try again in 15 minutes.';
    } else {
      // Many wrong passwords for this ACCOUNT, from any number of visitors: stop guessing unless a human check is passed. (Without
      // Turnstile configured the only safe choice is to wait; with it, the owner can always get in by solving the check.)
      let go = true;
      if (await isLimited(acct, ACCOUNT_MAX_FAILS, ACCOUNT_WINDOW_SECS)) {
        if (!turnstileOn()) { go = false; Astro.response.status = 429; error = 'Too many wrong passwords for this account. Try again in an hour.'; }
        else if (!(await verifyTurnstile(String(form.get('cf-turnstile-response') ?? ''), ipOf(Astro.request), { hostname: Astro.url.hostname, action: 'login' }))) {
          go = false; challenge = true; Astro.response.status = 429; error = 'There have been many wrong passwords for this account. Please complete the check below, then sign in.';
        }
      }
      if (go) {
        const id = await login(email, password);
        if (id === null) { await recordFailure(key); await recordFailure(acct, ACCOUNT_WINDOW_SECS); Astro.response.status = 401; error = 'Email or password is incorrect.'; challenge = await isLimited(acct, ACCOUNT_MAX_FAILS, ACCOUNT_WINDOW_SECS) && turnstileOn(); }
        else { await clearFailures(key); await clearFailures(acct); await createSession(id, Astro.cookies); return Astro.redirect('/dashboard'); }
      }
    }
  }
}
const site = await getSettings();
const sitekey = challenge ? turnstileSiteKey() : undefined;
if (sitekey) Astro.locals.challenge = true; // lets the Content-Security-Policy allow Cloudflare's check on this response
---
<Base title={canSetup ? 'Set up' : 'Sign in'} noindex bare>
  {sitekey && <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <main id="main" class="gate">
    <span class="gate-shape gate-a" aria-hidden="true"></span><span class="gate-shape gate-b" aria-hidden="true"></span>
    <a class="gate-back" href="/">← Back to {site.name}</a>
    <div class="gate-card">
      <p class="gate-brand">{site.name}<b>.</b></p>
      {canSetup ? (
        <>
          <h1>Set up your site</h1>
          <p class="gate-sub">Create the admin account. You need the <code>ADMIN_SETUP_TOKEN</code> secret you stored in Cloudflare. This form disappears once the account exists.</p>
        </>
      ) : (
        <>
          <h1>Sign in</h1>
          <p class="gate-sub">Welcome back. Sign in to manage your site.</p>
        </>
      )}
      {error && <p class="notice" role="alert" tabindex="-1" autofocus>{error}</p>}
      {!adminExists && !setupEnabled() && (
        <p class="notice" role="alert" tabindex="-1" autofocus>Registration is turned off because <code>ADMIN_SETUP_TOKEN</code> is not set (it must be at least 16 characters). Set it with <code>npx wrangler secret put ADMIN_SETUP_TOKEN</code>, then reload.</p>
      )}

      {canSetup && (
        <form method="post" class="stack" style="--stack:1rem">
          <input type="hidden" name="mode" value="setup" />
          <div class="field"><label for="token">Setup token</label><input id="token" name="token" type="password" autocomplete="off" required /></div>
          <div class="field"><label for="s-email">Email</label><input id="s-email" name="email" type="email" autocomplete="username" value={email} required /></div>
          <div class="field"><label for="s-pw">Password</label><div class="pwbox"><input id="s-pw" name="password" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required /><button type="button" class="pwtoggle" data-pw-toggle="s-pw" aria-pressed="false" hidden>Show</button></div><span class="hint">At least {MIN_PASSWORD} characters. A few random words works well.</span>
            <div class="meter" aria-hidden="true" data-meter><span></span></div><p class="meter-text" data-meter-text aria-live="polite"></p></div>
          <div class="field"><label for="s-pw2">Confirm password</label><div class="pwbox"><input id="s-pw2" name="confirm" type="password" autocomplete="new-password" minlength={MIN_PASSWORD} required /><button type="button" class="pwtoggle" data-pw-toggle="s-pw2" aria-pressed="false" hidden>Show</button></div></div>
          <button class="btn" type="submit">Create admin account</button>
        </form>
      )}

      {adminExists && (
        <form method="post" class="stack" style="--stack:1rem">
          <input type="hidden" name="mode" value="login" />
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" value={email} required /></div>
          <div class="field"><label for="pw">Password</label><div class="pwbox"><input id="pw" name="password" type="password" autocomplete="current-password" required /><button type="button" class="pwtoggle" data-pw-toggle="pw" aria-pressed="false" hidden>Show</button></div></div>
          {sitekey && <div class="cf-turnstile" data-sitekey={sitekey} data-action="login"></div>}
          <button class="btn" type="submit">Sign in</button>
        </form>
      )}
    </div>
  </main>
</Base>

<style>
  .gate { position: relative; min-height: 100dvh; display: grid; place-items: center; padding: 4.5rem 1rem 3rem; overflow: hidden; }
  .gate-back { position: absolute; top: 1.25rem; left: clamp(1rem, 4vw, 2.5rem); color: var(--muted); font-weight: 600; text-decoration: none; z-index: 2; }
  .gate-back:hover { color: var(--ink); text-decoration: underline; }
  .gate-shape { position: absolute; z-index: 0; pointer-events: none; }
  .gate-a { width: min(46vw, 520px); aspect-ratio: 1; border-radius: 50%; background: var(--brand); right: -12vw; top: -14vw; opacity: .95; }
  .gate-b { width: min(34vw, 380px); aspect-ratio: 1; border-radius: 50% 0 0 0; background: var(--gold); left: -8vw; bottom: -10vw; }
  .gate-card { position: relative; z-index: 1; width: min(100%, 28rem); padding: clamp(1.4rem, 4vw, 2rem); background: var(--card); border: 2px solid var(--outline); border-radius: var(--r-card, 28px); box-shadow: 8px 8px 0 var(--outline); display: grid; gap: 1rem; }
  .gate-brand { margin: 0; font-weight: 800; font-size: 1.05rem; letter-spacing: -.02em; }
  .gate-brand b { color: var(--brand); }
  .gate h1 { margin: 0; font-size: var(--step-3); }
  .gate-sub { margin: 0; color: var(--muted); }
  .notice { background: var(--tint); border: 1px solid var(--line); border-left: 4px solid var(--danger); border-radius: var(--r-input); padding: .75rem 1rem; margin: 0; }
  code { font-size: .9em; background: var(--surface-2); padding: .1em .4em; border-radius: 6px; }
  .pwbox { position: relative; display: grid; }
  .pwbox input { padding-right: 4.6rem; }
  .pwtoggle { position: absolute; right: .45rem; top: 50%; transform: translateY(-50%); padding: .3rem .65rem; border: 1.5px solid var(--outline); border-radius: 999px; background: var(--card); color: var(--ink); font: 700 .78rem/1 var(--font-body); cursor: pointer; }
  .pwtoggle:hover { background: var(--surface); }
  .pwtoggle[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  @media (pointer: coarse) { .gate-back { display: inline-flex; align-items: center; min-height: 44px; } .pwtoggle { min-height: 44px; min-width: 56px; right: .3rem; } .pwbox input { padding-right: 5rem; } }
</style>

<script>
  // A hint while you type a new password. The real rules (12+ characters) are enforced on the server.
  const pw = document.getElementById('s-pw') as HTMLInputElement | null;
  const bar = document.querySelector<HTMLElement>('[data-meter]');
  const text = document.querySelector<HTMLElement>('[data-meter-text]');
  if (pw && bar && text) {
    const fill = bar.firstElementChild as HTMLElement;
    pw.addEventListener('input', () => {
      const v = pw.value, kinds = [/[a-z]/, /[A-Z]/, /\d/, /[^A-Za-z0-9]/].filter((r) => r.test(v)).length;
      const level = v.length === 0 ? 0 : v.length < 12 ? 1 : v.length >= 20 || (v.length >= 16 && kinds >= 3) ? 3 : 2;
      bar.dataset.level = String(level);
      fill.style.width = ['0%', '33%', '66%', '100%'][level];
      text.textContent = ['', `${12 - v.length} more character${12 - v.length === 1 ? '' : 's'} to go.`, 'Long enough.', 'Strong.'][level];
    });
  }
</script>

<script>
  // Show/hide for password fields (a convenience; the fields work without it)
  document.querySelectorAll<HTMLButtonElement>('[data-pw-toggle]').forEach((b) => {
    const input = document.getElementById(b.dataset.pwToggle!) as HTMLInputElement;
    b.hidden = false;
    b.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      b.textContent = show ? 'Hide' : 'Show';
      b.setAttribute('aria-pressed', String(show));
    });
  });
</script>
